#lang racket
(require racket/draw
         "graph.rkt"
         "layout.rkt")

(provide render-graph->bitmap
         export-graph->png)

(define state-radius 22)

(define (col r g b) (make-object color% r g b))
(define edge-color (col #x5A #x6B #x7B))
(define edge-highlight-color (col #xE2 #x57 #x1F))
(define state-fill (col #xE9 #xF1 #xF8))
(define state-stroke (col #x2C #x5F #x8A))
(define state-fill-highlight (col #xF7 #xC8 #x73))
(define label-color (col #x22 #x30 #x3C))
(define start-color (col #x1B #x3A #x55))

(define label-font (make-object font% 11 'default))
(define state-font (make-object font% 12 'default))

(define (draw-graph dc width height positions g
                    #:highlight-edge [hedge #f]
                    #:highlight-state [hstate #f])
  (send dc set-brush "white" 'solid)
  (send dc set-pen "white" 1 'solid)
  (send dc draw-rectangle 0 0 width height)
  (for ([e (in-list (automaton-graph-edges g))])
    (define from (car e))
    (define label (cadr e))
    (define to (caddr e))
    (define p1 (hash-ref positions from))
    (define p2 (hash-ref positions to))
    (define highlighted? (and hedge (equal? e hedge)))
    (draw-edge dc p1 p2 label highlighted?))
  (draw-start-arrow dc (hash-ref positions (automaton-graph-start g)))
  (for ([s (in-list (automaton-graph-states g))])
    (draw-state dc (hash-ref positions s)
                s
                (member s (automaton-graph-accept g))
                (equal? s hstate))))

(define (edge-label-text label)
  (if (eq? label 'epsilon) "Îµ" (format "~a" label)))

(define (draw-edge dc p1 p2 label highlighted?)
  (if (equal? p1 p2)
      (draw-self-loop dc p1 label highlighted?)
      (draw-straight-edge dc p1 p2 label highlighted?)))

(define (draw-straight-edge dc p1 p2 label highlighted?)
  (define dx (- (car p2) (car p1)))
  (define dy (- (cdr p2) (cdr p1)))
  (define len (max 0.0001 (sqrt (+ (* dx dx) (* dy dy)))))
  (define ux (/ dx len))
  (define uy (/ dy len))
  (define sx (+ (car p1) (* ux state-radius)))
  (define sy (+ (cdr p1) (* uy state-radius)))
  (define ex (- (car p2) (* ux (+ state-radius 8))))
  (define ey (- (cdr p2) (* uy (+ state-radius 8))))
  (define color (if highlighted? edge-highlight-color edge-color))
  (define w (if highlighted? 3 1))
  (send dc set-pen color w 'solid)
  (send dc draw-line sx sy ex ey)
  (draw-arrowhead dc ex ey ux uy color w)
  (send dc set-font label-font)
  (send dc set-text-foreground label-color)
  (send dc draw-text (edge-label-text label)
        (+ (/ (+ sx ex) 2) (* (- uy) 9))
        (+ (/ (+ sy ey) 2) (* ux 9))))

(define (draw-self-loop dc p label highlighted?)
  (define x (car p))
  (define y (cdr p))
  (define r 13)
  (define cx (+ x (* state-radius 1.7)))
  (define cy y)
  (define color (if highlighted? edge-highlight-color edge-color))
  (define w (if highlighted? 3 1))
  (send dc set-pen color w 'solid)
  (send dc draw-arc (- cx r) (- cy r) (* 2 r) (* 2 r)
        (* pi 0.15) (* pi 1.85))
  (draw-arrowhead dc (+ cx r) cy 1 0 color w)
  (send dc set-font label-font)
  (send dc set-text-foreground label-color)
  (send dc draw-text (edge-label-text label) (+ cx r 6) (- cy 8)))

(define (draw-arrowhead dc x y ux uy color w)
  (define sz 8)
  (define px (- uy))
  (define py ux)
  (send dc set-brush color 'solid)
  (send dc set-pen color w 'solid)
  (define path (new dc-path%))
  (send path move-to x y)
  (send path line-to (- x (* ux sz) (* px (* sz 0.6)))
        (- y (* uy sz) (* py (* sz 0.6))))
  (send path line-to (- x (* ux sz) (* px (* sz -0.6)))
        (- y (* uy sz) (* py (* sz -0.6))))
  (send path close)
  (send dc draw-path path)
  (send dc set-brush "white" 'solid))

(define (draw-state dc p id accepting? highlighted?)
  (define x (car p))
  (define y (cdr p))
  (define r state-radius)
  (define fill (if highlighted? state-fill-highlight state-fill))
  (define stroke (if highlighted? edge-highlight-color state-stroke))
  (send dc set-brush fill 'solid)
  (send dc set-pen stroke 2 'solid)
  (send dc draw-ellipse (- x r) (- y r) (* 2 r) (* 2 r))
  (when accepting?
    (send dc set-pen stroke 1.5 'solid)
    (send dc draw-ellipse (- x (- r 5)) (- y (- r 5))
          (* 2 (- r 5)) (* 2 (- r 5))))
  (send dc set-font state-font)
  (send dc set-text-foreground label-color)
  (define label (format "~a" id))
  (define-values (tw th _d _s) (send dc get-text-extent label))
  (send dc draw-text label (- x (/ tw 2)) (- y (/ th 2))))

(define (draw-start-arrow dc p)
  (define x (car p))
  (define y (cdr p))
  (send dc set-pen start-color 2 'solid)
  (send dc draw-line (- x (* state-radius 2.4)) y (- x state-radius) y)
  (draw-arrowhead dc (- x state-radius) y 1 0 start-color 2))

(define (render-graph->bitmap g
                              #:highlight-edge [hedge #f]
                              #:highlight-state [hstate #f])
  (define-values (positions width height) (layout-graph g))
  (define bmp (make-object bitmap% (max 8 (ceiling width)) (max 8 (ceiling height))))
  (define dc (new bitmap-dc% [bitmap bmp]))
  (draw-graph dc (ceiling width) (ceiling height) positions g
              #:highlight-edge hedge
              #:highlight-state hstate)
  (send dc set-bitmap #f)
  bmp)

(define (export-graph->png g path)
  (define bmp (render-graph->bitmap g))
  (unless (send bmp save-file path 'png)
    (error 'export-graph->png "could not write PNG file ~a" path)))
