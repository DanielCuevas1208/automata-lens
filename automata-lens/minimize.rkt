#lang racket
(require "dfa.rkt")

(provide minimize-dfa)

(define (reachable-states aut)
  (define seen (make-hash))
  (define (visit s)
    (when (not (hash-has-key? seen s))
      (hash-set! seen s #t)
      (for ([(c t) (in-hash (hash-ref (dfa-trans aut) s))])
        (visit t))))
  (visit (dfa-start aut))
  (sort (hash-keys seen) <))

(define (partition-refine aut blocks)
  (define alphabet (dfa-alphabet aut))
  (define states (append* blocks))
  (define block->id (make-hash))
  (for ([b (in-list blocks)] [i (in-naturals)])
    (hash-set! block->id b i))
  (define (block-id-of s)
    (define b (first (filter (lambda (b) (member s b)) blocks)))
    (hash-ref block->id b))
  (define (accepting? s) (and (member s (dfa-accept aut)) #t))
  (define (signature s)
    (cons (accepting? s)
          (for/list ([c (in-list alphabet)])
            (block-id-of (hash-ref (hash-ref (dfa-trans aut) s) c)))))
  (define groups (make-hash))
  (for ([s (in-list states)])
    (hash-update! groups (signature s) (lambda (lst) (cons s lst)) '()))
  (sort (map (lambda (lst) (sort lst <)) (hash-values groups))
        (lambda (a b) (< (car a) (car b)))))

(define (refine-to-fixpoint aut blocks)
  (define next (partition-refine aut blocks))
  (if (equal? blocks next)
      blocks
      (refine-to-fixpoint aut next)))

(define (minimize-dfa aut)
  (define alphabet (dfa-alphabet aut))
  (define states (reachable-states aut))
  (define (accepting? s) (and (member s (dfa-accept aut)) #t))
  (define initial
    (filter (lambda (b) (pair? b))
            (list (sort (filter accepting? states) <)
                  (sort (filter (compose not accepting?) states) <))))
  (define blocks (refine-to-fixpoint aut initial))
  (define block->id (make-hash))
  (for ([b (in-list blocks)] [i (in-naturals)])
    (hash-set! block->id b i))
  (define (id-of-state s)
    (define b (first (filter (lambda (b) (member s b)) blocks)))
    (hash-ref block->id b))
  (define new-start (id-of-state (dfa-start aut)))
  (define new-accept (sort (remove-duplicates (map id-of-state (dfa-accept aut))) <))
  (define new-trans (make-hash))
  (for ([b (in-list blocks)])
    (define rep (car b))
    (define id (hash-ref block->id b))
    (define row (make-hash))
    (for ([c (in-list alphabet)])
      (hash-set! row c (id-of-state (hash-ref (hash-ref (dfa-trans aut) rep) c))))
    (hash-set! new-trans id row))
  (define new-states (sort (remove-duplicates (hash-keys new-trans)) <))
  (dfa new-states new-start new-accept alphabet new-trans))
